{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floatcraft",
  "version": "0.1.2",
  "identifier": "com.erikgajiumarovi.floatcraft",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Floatcraft",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:5173; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2QUU1MDg0NkRENzFBMDkKUldRSkd0ZHRoRkN1NW92TXFjMTdGNkhTRkxPc25xTjdiWEtTcWc5enl5b3pNdW02ZENLb0lTUXAK",
      "endpoints": [
        "https://github.com/ErikGajiumarovi/cs_float_hacker/releases/latest/download/latest.json"
      ]
    }
  }
}
